{
  "name": "bike-spare-saas",
  "version": "1.0.0",
  "description": "Bike Spare Parts SaaS Platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "frontend",
    "api"
  ],
  "scripts": {
    "dev": "concurrently \"npm -C frontend run dev\" \"npm -C api run dev\"",
    "build": "npm -C frontend run build",
    "start": "npm -C api run start"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
