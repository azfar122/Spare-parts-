{
  "version": 2,
  "installCommand": "npm install --include=dev --include=optional",
  "buildCommand": "npm -C frontend run build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ],
  "env": {
    "VITE_API_URL": "/api",
    "VITE_SOCKET_URL": ""
  }
}
